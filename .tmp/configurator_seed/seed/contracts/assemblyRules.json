{
  "version": "1.0.0",
  "units": "mm",
  "note": "Frozen contract. The engine reads this; it does not invent junction math. Offsets come from data/recipes, not from here.",

  "componentRoles": {
    "frame":           { "swept": true,  "path": "outer_perimeter" },
    "sash":            { "swept": true,  "path": "cell_perimeter", "seatsOn": "frame", "via": "rebate" },
    "mullion_fixed":   { "swept": true,  "path": "division_line", "spans": "frame_to_frame" },
    "mullion_movable": { "swept": true,  "path": "division_line", "spans": "frame_to_frame", "movable": true },
    "glazing_bead":    { "swept": true,  "path": "cell_perimeter", "carriedBy": ["sash","frame"] },
    "glass":           { "swept": true,  "path": "cell_aperture", "seatsIn": "glazingPocket" },
    "gasket":          { "swept": true,  "path": "follows_carrier" },
    "subsill":         { "swept": true,  "path": "bottom" },
    "threshold":       { "swept": true,  "path": "bottom" }
  },

  "corners": {
    "policy": "mitre",
    "angleDeg": 45,
    "appliesTo": ["frame","sash","glazing_bead","mullion_fixed","mullion_movable"],
    "reference": "anchors.mitreReference"
  },

  "junctions": {
    "_source": "Offsets are MEASURED in data/recipes/zlozenie_recipes.json. The engine resolves a junction by looking up the matching recipe, NOT by computing offsets.",
    "frame_sash":        { "recipeMatch": ["frame","sash"] },
    "frame_sash_fixedMullion":   { "recipeMatch": ["frame","sash","mullion_fixed"] },
    "frame_sash_movableMullion": { "recipeMatch": ["frame","sash","mullion_movable"] }
  },

  "windowTypes": {
    "single_fixed":            { "cells": 1, "sash": false },
    "single_sash":             { "cells": 1, "sash": true },
    "double_fixed_mullion":    { "cells": 2, "division": "vertical", "mullion": "fixed" },
    "double_movable_mullion":  { "cells": 2, "division": "vertical", "mullion": "movable" }
  }
}
