{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedProfile",
  "description": "One window-system cross-section component, extracted from CAD. Pure data.",
  "type": "object",
  "required": ["name", "component", "units", "loops", "bbox"],
  "additionalProperties": false,
  "properties": {
    "name":      { "type": "string", "description": "Source block name (catalog id)." },
    "component": {
      "type": "string",
      "enum": ["frame","sash","mullion_fixed","mullion_movable","glazing_bead",
               "glass","gasket","subsill","drip_cap","threshold","spacer_bridge"]
    },
    "material":  { "type": "string", "enum": ["pvc","wood","aluminium"], "default": "pvc" },
    "units":     { "type": "string", "enum": ["mm"], "default": "mm" },
    "has_region":{ "type": "boolean", "description": "True if source had un-tessellated ACIS; geometry may be incomplete." },
    "bbox":      { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["closed", "pts"],
        "properties": {
          "closed": { "type": "boolean" },
          "pts": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "minItems": 2
          }
        }
      }
    },
    "anchors": {
      "type": "object",
      "description": "Semantic reference points/lines in the profile's local frame. Auto-detected where possible; the rest live in the family meta.json.",
      "properties": {
        "rebateLine":   { "type": "array", "items": { "type": "number" } },
        "glazingPocket":{ "type": "array", "items": { "type": "number" } },
        "mitreReference":{ "type": "array", "items": { "type": "number" } },
        "weatherLine":  { "type": "array", "items": { "type": "number" } },
        "systemDepth":  { "type": "number" },
        "viewHeight":   { "type": "number" }
      }
    }
  }
}
